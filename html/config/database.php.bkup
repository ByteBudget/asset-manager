<?php
// Session initialization & CSRF Security Helper Functions
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

// Generate CSRF Token
if (empty($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
}

define('DB_HOST', getenv('DB_HOST') ?: '127.0.0.1');
define('DB_NAME', getenv('DB_NAME') ?: 'asset_management');
define('DB_USER', getenv('DB_USER') ?: 'asset_user');
define('DB_PASS', getenv('DB_PASS') ?: 'your_secure_password');
define('DB_CHARSET', 'utf8mb4');

/**
 * Returns a PDO database instance using Singleton pattern connection settings.
 */
function getDBConnection(): PDO {
    static $pdo = null;
    if ($pdo === null) {
        $dsn = "mysql:host=" . DB_HOST . ";dbname=" . DB_NAME . ";charset=" . DB_CHARSET;
        $options = [
            PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES   => false,
        ];
        try {
            $pdo = new PDO($dsn, DB_USER, DB_PASS, $options);
        } catch (PDOException $e) {
            die("Database Connection Error: " . htmlspecialchars($e->getMessage()));
        }
    }
    return $pdo;
}

/**
 * Validates post request CSRF token
 */
function verifyCSRF(): void {
    if ($_SERVER['REQUEST_METHOD'] === 'POST') {
        if (!isset($_POST['csrf_token']) || !hash_equals($_SESSION['csrf_token'], $_POST['csrf_token'])) {
            die('Invalid CSRF token submission.');
        }
    }
}

/**
 * Helper to safely sanitize standard string outputs
 */
function sanitize(?string $string): string {
    return htmlspecialchars($string ?? '', ENT_QUOTES, 'UTF-8');
}

/**
 * Auto-generates the next sequential asset tag (e.g., AST-00001)
 */
function generateNextAssetTag(string $prefix = 'AST-', int $padding = 5): string {
    $pdo = getDBConnection();
    
    // Fetch the latest asset tag matching the prefix format
    $stmt = $pdo->query("SELECT asset_tag FROM assets WHERE asset_tag LIKE '{$prefix}%' ORDER BY id DESC LIMIT 1");
    $lastTag = $stmt->fetchColumn();

    if ($lastTag) {
        // Extract the numeric portion and increment
        $number = (int) str_replace($prefix, '', $lastTag);
        $nextNumber = $number + 1;
    } else {
        $nextNumber = 1;
    }

    // Format with leading zeros (e.g., AST-00001)
    return $prefix . str_pad((string)$nextNumber, $padding, '0', STR_PAD_LEFT);
}
